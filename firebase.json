{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "dist", "src", "tests", ".env*", "firebase-debug.log"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
